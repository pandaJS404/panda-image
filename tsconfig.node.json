{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "composite": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["api/**/*.js", "bin/**/*.js", "cypress.config.js", "vite.config.mts"]
}
